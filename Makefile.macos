.DEFAULT_GOAL := all
CC       := clang
CFLAGS   := -std=c11 -O2 -Wall -Wextra -Iinclude -Ivendor/needle
OBJCFLAGS:= -O2 -Wall -Wextra -Iinclude -Ivendor/needle -fobjc-arc
LDFLAGS  := vendor/needle/libneedle.a build/echo/libspeexdsp.a -lc++ -lsqlite3 -lcurl \
            -framework CoreAudio \
            -framework AudioToolbox \
            -framework AVFoundation \
            -framework CoreFoundation \
            -framework ApplicationServices \
            -framework EventKit \
            -framework Cocoa

# Keep offline simulation and acoustic fixtures out of the shipped app.
SESSION_SRCS := src/deferred_store.c src/macos/deferred.c src/local_stt.c src/database.c src/storage.c src/ai_settings.c src/filesystem.c src/diagnostics.c src/config.c src/mic_monitor.c \
                src/macos/whistle_engine.c src/macos/diarizer.c src/macos/recap.c \
                src/live_session.c src/macos/transcript.c src/capture_buffer.c src/audio_processing.c src/echo.c
CAPTURE_SRCS := src/capture_macos.c
OFFLINE_SRCS := src/wav_audio.c tests/capture_buffer_verify.c src/simulated_monitor.c src/vad.c src/session.c src/room_bench.c
APP_SRCS := src/macos/retranscribe.c $(SESSION_SRCS) $(CAPTURE_SRCS) src/macos/control.m src/macos/settings.m src/macos/activity.m src/menubar_macos.m src/app_main.c
HARNESS_SRCS := $(SESSION_SRCS) $(CAPTURE_SRCS) $(OFFLINE_SRCS) src/harness_main.c
REGRESSION_SRCS := $(SESSION_SRCS) tests/regression_main.c
CONTROL_TEST_SRCS := $(SESSION_SRCS) src/macos/control.m tests/control_main.m
HISTORY_TEST_SRCS := $(filter-out src/app_main.c,$(APP_SRCS)) tests/history_macos.m
LOCAL_STT_PIPELINE_SRCS := $(SESSION_SRCS) $(CAPTURE_SRCS) src/wav_audio.c tests/local_stt_pipeline.c

OBJ_DIR := build/macos
objects = $(addprefix $(OBJ_DIR)/,$(addsuffix .o,$(basename $(1))))
ALL_OBJS := $(sort $(call objects,$(APP_SRCS) $(HARNESS_SRCS) $(REGRESSION_SRCS) $(CONTROL_TEST_SRCS) $(HISTORY_TEST_SRCS) $(LOCAL_STT_PIPELINE_SRCS)))
$(ALL_OBJS): Makefile.macos
-include $(ALL_OBJS:.o=.d)

BIN_DIR  := bin
HARNESS  := $(BIN_DIR)/ascolto-harness
REGRESSION := $(BIN_DIR)/ascolto-regression
CONTROL  := $(BIN_DIR)/ascoltoctl
APP_BIN  := $(BIN_DIR)/ascolto
APP_BUNDLE := $(BIN_DIR)/Ascolto.app
BUNDLE_STAMP := $(APP_BUNDLE)/Contents/.packaged
LOCAL_STT_LIBS := $(wildcard bin/local-stt/*.dylib)
RUNTIME_FILES := scripts/recap.py scripts/ai_providers.py scripts/ai_workflows.py scripts/ascolto_job_diagnostics.py \
                 scripts/ascolto_runtime.py scripts/ascolto_diagnostics.py scripts/ascolto_database.py scripts/ascolto_files.py scripts/organize_archive.py \
                 scripts/database_schema.sql scripts/requirements-recap.txt

.PHONY: all deps fixtures build bundle test test-capture room-bench simulate probe run clean

all: build bundle

deps: build/echo/libspeexdsp.a
	@mkdir -p vendor/needle models
	@test -f vendor/needle/needle.h || curl -fL https://huggingface.co/Cactus-Compute/needle3/resolve/main/macos-arm64/needle.h -o vendor/needle/needle.h
	@test -f vendor/needle/libneedle.a || curl -fL https://huggingface.co/Cactus-Compute/needle3/resolve/main/macos-arm64/libneedle.a -o vendor/needle/libneedle.a
	@test -f models/whistle.cact || curl -fL https://huggingface.co/Cactus-Compute/whistle/resolve/main/whistle.cact -o models/whistle.cact

$(OBJ_DIR)/src/echo.o: OBJCFLAGS += -Ibuild/echo/speexdsp/include -Ibuild/echo/native
$(APP_BIN) $(HARNESS) $(REGRESSION) $(BIN_DIR)/ascolto-control-test $(BIN_DIR)/ascolto-history-test $(BIN_DIR)/ascolto-local-stt-pipeline: build/echo/libspeexdsp.a

fixtures:
	@chmod +x scripts/gen_fixtures.sh
	@./scripts/gen_fixtures.sh

$(CONTROL): tools/ascoltoctl.c
	@mkdir -p $(BIN_DIR)
	$(CC) -std=c11 -Wall -Wextra -O2 $< -o $@

# Preserve the existing Objective-C compilation mode for the native sources.
$(OBJ_DIR)/%.o: %.c | deps
	@mkdir -p $(@D)
	$(CC) $(OBJCFLAGS) -MMD -MP -c -x objective-c $< -o $@

$(OBJ_DIR)/%.o: %.m | deps
	@mkdir -p $(@D)
	$(CC) $(OBJCFLAGS) -MMD -MP -c $< -o $@

$(HARNESS): $(call objects,$(HARNESS_SRCS)) vendor/needle/libneedle.a
	@mkdir -p $(@D)
	$(CC) $(call objects,$(HARNESS_SRCS)) $(LDFLAGS) -o $@

$(APP_BIN): $(call objects,$(APP_SRCS)) vendor/needle/libneedle.a
	@mkdir -p $(@D)
	$(CC) $(call objects,$(APP_SRCS)) $(LDFLAGS) -o $@

$(REGRESSION): $(call objects,$(REGRESSION_SRCS)) vendor/needle/libneedle.a
	@mkdir -p $(@D)
	$(CC) $(call objects,$(REGRESSION_SRCS)) $(LDFLAGS) -o $@

$(BIN_DIR)/ascolto-control-test: $(call objects,$(CONTROL_TEST_SRCS)) vendor/needle/libneedle.a
	@mkdir -p $(@D)
	$(CC) $(call objects,$(CONTROL_TEST_SRCS)) $(LDFLAGS) -o $@

# These files are produced by deps before compilation, including on a fresh checkout.
vendor/needle/libneedle.a models/whistle.cact: | deps
	@test -f $@

build: $(CONTROL) $(HARNESS) $(APP_BIN) $(REGRESSION) $(BIN_DIR)/ascolto-control-test

bundle: $(BUNDLE_STAMP)

assets/Ascolto.icns: assets/ascolto-app-icon.png scripts/build_app_icon.sh
	@sh scripts/build_app_icon.sh

$(BUNDLE_STAMP): $(APP_BIN) models/whistle.cact $(RUNTIME_FILES) assets/chatgpt-logo.svg assets/Ascolto.icns $(LOCAL_STT_LIBS) $(wildcard .venv/.ascolto-runtime-ready) Makefile.macos build/echo/SPEEXDSP-LICENSE.txt
	@mkdir -p $(APP_BUNDLE)/Contents/MacOS $(APP_BUNDLE)/Contents/Resources
	@cp $(APP_BIN) $(APP_BUNDLE)/Contents/MacOS/Ascolto
	@cp assets/chatgpt-logo.svg $(APP_BUNDLE)/Contents/Resources/
	@cp assets/Ascolto.icns $(APP_BUNDLE)/Contents/Resources/Ascolto.icns
	@cp build/echo/SPEEXDSP-LICENSE.txt $(APP_BUNDLE)/Contents/Resources/
	@if test -d bin/local-stt; then rm -rf $(APP_BUNDLE)/Contents/Resources/local-stt; mkdir -p $(APP_BUNDLE)/Contents/Resources/local-stt; cp -R bin/local-stt/. $(APP_BUNDLE)/Contents/Resources/local-stt/; fi
	@cp models/whistle.cact $(APP_BUNDLE)/Contents/Resources/whistle.cact
	@cp $(RUNTIME_FILES) $(APP_BUNDLE)/Contents/Resources/
	@if test -x .venv/bin/python3 && .venv/bin/python3 -c 'import numpy, requests, jwt, cryptography' >/dev/null 2>&1; then \
		rm -rf $(APP_BUNDLE)/Contents/Resources/python; \
		mkdir -p $(APP_BUNDLE)/Contents/Resources/python; \
		cp -RL .venv/. $(APP_BUNDLE)/Contents/Resources/python/; \
	fi
	@printf '%s\n' \
		'<?xml version="1.0" encoding="UTF-8"?>' \
		'<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">' \
		'<plist version="1.0">' \
		'<dict>' \
		'  <key>CFBundleExecutable</key><string>Ascolto</string>' \
		'  <key>CFBundleIdentifier</key><string>com.cristianbianco.ascolto</string>' \
		'  <key>CFBundleName</key><string>Ascolto</string>' \
		'  <key>CFBundleDisplayName</key><string>Ascolto</string>' \
		'  <key>CFBundleIconFile</key><string>Ascolto</string>' \
		'  <key>CFBundlePackageType</key><string>APPL</string>' \
		'  <key>CFBundleShortVersionString</key><string>1.0</string>' \
		'  <key>LSUIElement</key><true/>' \
		'  <key>NSMicrophoneUsageDescription</key><string>Ascolto usa il microfono per trascrivere la tua voce durante le call.</string>' \
		'  <key>NSAudioCaptureUsageDescription</key><string>Ascolto cattura l audio di sistema della call per distinguere e trascrivere gli altri partecipanti.</string>' \
		'  <key>NSCalendarsFullAccessUsageDescription</key><string>Ascolto legge il titolo e i partecipanti della call in corso dal Calendario per arricchire la trascrizione.</string>' \
		'  <key>NSCalendarsUsageDescription</key><string>Ascolto legge il titolo e i partecipanti della call in corso dal Calendario per arricchire la trascrizione.</string>' \
		'</dict>' \
		'</plist>' > $(APP_BUNDLE)/Contents/Info.plist
	# Include the packaging marker in the resource seal on clean builds.
	@touch $@
	@codesign --force --deep --sign - $(APP_BUNDLE) || { rm -f "$@"; exit 1; }
	@codesign --verify --deep --strict $(APP_BUNDLE) || { rm -f "$@"; exit 1; }

test: build bundle test-portable test-history
	@test -f tests/fixtures/spk3_turn1.wav || $(MAKE) fixtures
	./$(HARNESS) test
	./$(REGRESSION)
	./$(BIN_DIR)/ascolto-control-test
	@smoke_dir=$$(mktemp -d /tmp/ascolto-menu-smoke-XXXXXX); ./$(APP_BIN) --config "$$smoke_dir/config.json" --smoke-test; result=$$?; rm -rf "$$smoke_dir"; exit $$result

room-bench: build
	@test -f tests/fixtures/spk3_turn1.wav || $(MAKE) fixtures
	./$(HARNESS) room-bench --output tests/room-results

test-capture: bundle
	python3 scripts/test_capture.py

simulate: build
	@test -f tests/fixtures/call_mic.wav || $(MAKE) fixtures
	./$(HARNESS) simulate \
		--mic tests/fixtures/call_mic.wav \
		--sys tests/fixtures/call_sys.wav \
		--lang it \
		--keywords $$'Cristian\nprogetto\ndesign\nserver\nsviluppo\ndocumento' \
		--trace /tmp/ascolto-test/call_trace.jsonl

probe: build
	./$(HARNESS) probe-macos
	./$(HARNESS) probe-engine

run: bundle
	open $(APP_BUNDLE)

clean:
	rm -rf $(BIN_DIR) $(OBJ_DIR)
	rm -f build/local-stt/.ready

.PHONY: test-settings
bin/ascolto-settings-test: src/macos/activity.m src/macos/activity.h src/local_stt.c src/local_stt_manifest.inc include/ascolto/local_stt.h src/macos/settings.m src/macos/settings.h src/ai_settings.c src/storage.c src/database.c src/database_schema.inc src/filesystem.c src/macos/retranscribe.c src/deferred_store.c tests/settings_macos.m
	@mkdir -p bin
	$(CC) $(OBJCFLAGS) src/macos/activity.m src/macos/settings.m src/local_stt.c src/ai_settings.c src/storage.c src/database.c src/filesystem.c src/macos/retranscribe.c src/deferred_store.c tests/settings_macos.m -lcurl -lsqlite3 -lpthread -framework Cocoa -framework AudioToolbox -framework CoreFoundation -o $@

test-settings: bin/ascolto-settings-test
	./bin/ascolto-settings-test build/settings-previews

.PHONY: test-activity
bin/ascolto-app-icon-test: tests/app_icon_macos.m src/macos/app_icon.h
	@mkdir -p bin
	$(CC) $(OBJCFLAGS) tests/app_icon_macos.m -framework Cocoa -o $@

.PHONY: test-app-icon
test-app-icon: bundle bin/ascolto-app-icon-test
	./bin/ascolto-app-icon-test "$(abspath $(APP_BUNDLE))" build/app-icon-runtime.png

bin/ascolto-activity-test: src/macos/settings.m src/macos/settings.h src/local_stt.c src/macos/activity.m src/macos/activity.h tests/activity_macos.m src/ai_settings.c src/storage.c src/database.c src/filesystem.c
	@mkdir -p bin
	$(CC) $(OBJCFLAGS) src/macos/settings.m src/local_stt.c src/macos/activity.m src/ai_settings.c src/storage.c src/database.c src/filesystem.c tests/activity_macos.m -lcurl -lsqlite3 -lpthread -framework Cocoa -o $@

test-activity: bin/ascolto-activity-test
	./bin/ascolto-activity-test build/activity-previews

.PHONY: test-history
bin/ascolto-history-test: $(call objects,$(HISTORY_TEST_SRCS)) vendor/needle/libneedle.a
	@mkdir -p bin
	$(CC) $(call objects,$(HISTORY_TEST_SRCS)) $(LDFLAGS) -o $@

test-history: bin/ascolto-history-test
	./bin/ascolto-history-test

# Explicit, offline opt-in checks require already installed weights in TEMP_CONFIG's directory.
$(BIN_DIR)/ascolto-local-stt-runtime: src/local_stt.c src/database.c src/storage.c src/filesystem.c src/ai_settings.c src/wav_audio.c tests/local_stt_runtime.c
	$(CC) $(CFLAGS) $^ -lcurl -lsqlite3 -lpthread -lm -o $@

$(BIN_DIR)/ascolto-local-stt-pipeline: $(call objects,$(LOCAL_STT_PIPELINE_SRCS)) vendor/needle/libneedle.a
	$(CC) $(call objects,$(LOCAL_STT_PIPELINE_SRCS)) $(LDFLAGS) -o $@

# Persistent post-call jobs, native worker scheduling and production audio replay.
DEFERRED_STORE_TEST_SRCS := src/database.c src/storage.c src/ai_settings.c src/filesystem.c src/deferred_store.c
.PHONY: test-deferred
test-deferred: $(BIN_DIR)/ascolto-deferred-store-test $(BIN_DIR)/ascolto-deferred-worker-test $(BIN_DIR)/ascolto-deferred-pipeline-test
	./$(BIN_DIR)/ascolto-deferred-store-test
	./$(BIN_DIR)/ascolto-deferred-worker-test
	./$(BIN_DIR)/ascolto-deferred-pipeline-test

$(BIN_DIR)/ascolto-deferred-store-test: $(DEFERRED_STORE_TEST_SRCS) tests/deferred_store.c include/ascolto/deferred_store.h src/database_schema.inc
	@mkdir -p $(BIN_DIR)
	$(CC) -std=c11 -Wall -Wextra -O2 -Iinclude $(DEFERRED_STORE_TEST_SRCS) tests/deferred_store.c -lsqlite3 -lpthread -o $@

$(BIN_DIR)/ascolto-deferred-worker-test: $(DEFERRED_STORE_TEST_SRCS) src/macos/deferred.c tests/deferred_worker.c include/ascolto/deferred.h include/ascolto/deferred_store.h src/database_schema.inc
	@mkdir -p $(BIN_DIR)
	$(CC) -std=c11 -Wall -Wextra -O2 -Iinclude $(DEFERRED_STORE_TEST_SRCS) src/macos/deferred.c tests/deferred_worker.c -lsqlite3 -lpthread -o $@

$(BIN_DIR)/ascolto-deferred-pipeline-test: $(DEFERRED_STORE_TEST_SRCS) src/config.c src/audio_processing.c src/echo.c src/macos/diarizer.c src/live_session.c src/macos/transcript.c tests/deferred_pipeline.c include/ascolto.h include/ascolto/echo.h include/ascolto/deferred_store.h src/database_schema.inc build/echo/libspeexdsp.a
	@mkdir -p $(BIN_DIR)
	$(CC) -std=c11 -Wall -Wextra -O2 -Iinclude -Ibuild/echo/speexdsp/include -Ibuild/echo/native $(DEFERRED_STORE_TEST_SRCS) src/config.c src/audio_processing.c src/echo.c src/macos/diarizer.c src/live_session.c src/macos/transcript.c tests/deferred_pipeline.c build/echo/libspeexdsp.a -lsqlite3 -lpthread -lm -o $@

.PHONY: test-startup-guard
test: test-deferred test-startup-guard test-echo
test-startup-guard: $(APP_BIN)
	ASCOLTO_STARTUP_TEST_BINARY=$(APP_BIN) python3 -m unittest discover -s tests -p 'test_startup_guard.py'

.PHONY: test-retranscribe
test-retranscribe: $(BIN_DIR)/ascolto-retranscribe-test
	./$(BIN_DIR)/ascolto-retranscribe-test

$(BIN_DIR)/ascolto-retranscribe-test: $(DEFERRED_STORE_TEST_SRCS) src/macos/retranscribe.c tests/retranscribe.c include/ascolto/retranscribe.h include/ascolto/deferred_store.h src/database_schema.inc
	@mkdir -p $(BIN_DIR)
	$(CC) -std=c11 -Wall -Wextra -O2 -Iinclude $(DEFERRED_STORE_TEST_SRCS) src/macos/retranscribe.c tests/retranscribe.c -lsqlite3 -lpthread -framework AudioToolbox -framework CoreFoundation -o $@

test: test-retranscribe
