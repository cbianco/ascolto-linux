.DEFAULT_GOAL := all
CC       := clang
CFLAGS   := -std=c11 -O2 -Wall -Wextra -Iinclude -Ivendor/needle
OBJCFLAGS:= -O2 -Wall -Wextra -Iinclude -Ivendor/needle -fobjc-arc
LDFLAGS  := vendor/needle/libneedle.a -lc++ \
            -framework CoreAudio \
            -framework AudioToolbox \
            -framework AVFoundation \
            -framework CoreFoundation \
            -framework ApplicationServices \
            -framework EventKit \
            -framework Cocoa

# Keep offline simulation and acoustic fixtures out of the shipped app.
SESSION_SRCS := src/filesystem.c src/diagnostics.c src/config.c src/mic_monitor.c \
                src/macos/whistle_engine.c src/macos/diarizer.c src/macos/recap.c \
                src/live_session.c src/macos/transcript.c src/capture_buffer.c src/audio_processing.c
CAPTURE_SRCS := src/capture_macos.c
OFFLINE_SRCS := src/wav_audio.c tests/capture_buffer_verify.c src/simulated_monitor.c src/vad.c src/session.c src/room_bench.c
APP_SRCS := $(SESSION_SRCS) $(CAPTURE_SRCS) src/macos/control.m src/menubar_macos.m src/app_main.c
HARNESS_SRCS := $(SESSION_SRCS) $(CAPTURE_SRCS) $(OFFLINE_SRCS) src/harness_main.c
REGRESSION_SRCS := $(SESSION_SRCS) tests/regression_main.c
CONTROL_TEST_SRCS := $(SESSION_SRCS) src/macos/control.m tests/control_main.m

OBJ_DIR := build/macos
objects = $(addprefix $(OBJ_DIR)/,$(addsuffix .o,$(basename $(1))))
ALL_OBJS := $(sort $(call objects,$(APP_SRCS) $(HARNESS_SRCS) $(REGRESSION_SRCS) $(CONTROL_TEST_SRCS)))
$(ALL_OBJS): Makefile.macos
-include $(ALL_OBJS:.o=.d)

BIN_DIR  := bin
HARNESS  := $(BIN_DIR)/ascolto-harness
REGRESSION := $(BIN_DIR)/ascolto-regression
CONTROL  := $(BIN_DIR)/ascoltoctl
APP_BIN  := $(BIN_DIR)/ascolto
APP_BUNDLE := $(BIN_DIR)/Ascolto.app
BUNDLE_STAMP := $(APP_BUNDLE)/Contents/.packaged

.PHONY: all deps fixtures build bundle test test-capture room-bench simulate probe run clean

all: build bundle

deps:
	@mkdir -p vendor/needle models
	@test -f vendor/needle/needle.h || curl -fL https://huggingface.co/Cactus-Compute/needle3/resolve/main/macos-arm64/needle.h -o vendor/needle/needle.h
	@test -f vendor/needle/libneedle.a || curl -fL https://huggingface.co/Cactus-Compute/needle3/resolve/main/macos-arm64/libneedle.a -o vendor/needle/libneedle.a
	@test -f models/whistle.cact || curl -fL https://huggingface.co/Cactus-Compute/whistle/resolve/main/whistle.cact -o models/whistle.cact

fixtures:
	@chmod +x scripts/gen_fixtures.sh
	@./scripts/gen_fixtures.sh

$(CONTROL): tools/ascoltoctl.c
	@mkdir -p $(BIN_DIR)
	$(CC) -std=c11 -Wall -Wextra -O2 $< -o $@

# Preserve the existing Objective-C compilation mode for the native sources.
$(OBJ_DIR)/%.o: %.c | deps
	@mkdir -p $(@D)
	$(CC) $(OBJCFLAGS) -MMD -MP -c -x objective-c $< -o $@

$(OBJ_DIR)/%.o: %.m | deps
	@mkdir -p $(@D)
	$(CC) $(OBJCFLAGS) -MMD -MP -c $< -o $@

$(HARNESS): $(call objects,$(HARNESS_SRCS)) vendor/needle/libneedle.a
	@mkdir -p $(@D)
	$(CC) $(call objects,$(HARNESS_SRCS)) $(LDFLAGS) -o $@

$(APP_BIN): $(call objects,$(APP_SRCS)) vendor/needle/libneedle.a
	@mkdir -p $(@D)
	$(CC) $(call objects,$(APP_SRCS)) $(LDFLAGS) -o $@

$(REGRESSION): $(call objects,$(REGRESSION_SRCS)) vendor/needle/libneedle.a
	@mkdir -p $(@D)
	$(CC) $(call objects,$(REGRESSION_SRCS)) $(LDFLAGS) -o $@

$(BIN_DIR)/ascolto-control-test: $(call objects,$(CONTROL_TEST_SRCS)) vendor/needle/libneedle.a
	@mkdir -p $(@D)
	$(CC) $(call objects,$(CONTROL_TEST_SRCS)) $(LDFLAGS) -o $@

# These files are produced by deps before compilation, including on a fresh checkout.
vendor/needle/libneedle.a models/whistle.cact: | deps
	@test -f $@

build: $(CONTROL) $(HARNESS) $(APP_BIN) $(REGRESSION) $(BIN_DIR)/ascolto-control-test

bundle: $(BUNDLE_STAMP)

$(BUNDLE_STAMP): $(APP_BIN) models/whistle.cact scripts/recap.py scripts/requirements-recap.txt Makefile.macos
	@mkdir -p $(APP_BUNDLE)/Contents/MacOS $(APP_BUNDLE)/Contents/Resources
	@cp $(APP_BIN) $(APP_BUNDLE)/Contents/MacOS/Ascolto
	@cp models/whistle.cact $(APP_BUNDLE)/Contents/Resources/whistle.cact
	@cp scripts/recap.py scripts/requirements-recap.txt $(APP_BUNDLE)/Contents/Resources/
	@printf '%s\n' \
		'<?xml version="1.0" encoding="UTF-8"?>' \
		'<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">' \
		'<plist version="1.0">' \
		'<dict>' \
		'  <key>CFBundleExecutable</key><string>Ascolto</string>' \
		'  <key>CFBundleIdentifier</key><string>com.cristianbianco.ascolto</string>' \
		'  <key>CFBundleName</key><string>Ascolto</string>' \
		'  <key>CFBundleDisplayName</key><string>Ascolto</string>' \
		'  <key>CFBundlePackageType</key><string>APPL</string>' \
		'  <key>CFBundleShortVersionString</key><string>1.0</string>' \
		'  <key>LSUIElement</key><true/>' \
		'  <key>NSMicrophoneUsageDescription</key><string>Ascolto usa il microfono per trascrivere la tua voce durante le call.</string>' \
		'  <key>NSAudioCaptureUsageDescription</key><string>Ascolto cattura l audio di sistema della call per distinguere e trascrivere gli altri partecipanti.</string>' \
		'  <key>NSCalendarsFullAccessUsageDescription</key><string>Ascolto legge il titolo e i partecipanti della call in corso dal Calendario per arricchire la trascrizione.</string>' \
		'  <key>NSCalendarsUsageDescription</key><string>Ascolto legge il titolo e i partecipanti della call in corso dal Calendario per arricchire la trascrizione.</string>' \
		'</dict>' \
		'</plist>' > $(APP_BUNDLE)/Contents/Info.plist
	@codesign --force --deep --sign - $(APP_BUNDLE)
	@touch $@

test: build bundle test-portable
	@test -f tests/fixtures/spk3_turn1.wav || $(MAKE) fixtures
	./$(HARNESS) test
	./$(REGRESSION)
	./$(BIN_DIR)/ascolto-control-test
	./$(APP_BIN) --config /tmp/ascolto-test/smoke_config.json --smoke-test

room-bench: build
	@test -f tests/fixtures/spk3_turn1.wav || $(MAKE) fixtures
	./$(HARNESS) room-bench --output tests/room-results

test-capture: bundle
	python3 scripts/test_capture.py

simulate: build
	@test -f tests/fixtures/call_mic.wav || $(MAKE) fixtures
	./$(HARNESS) simulate \
		--mic tests/fixtures/call_mic.wav \
		--sys tests/fixtures/call_sys.wav \
		--lang it \
		--keywords $$'Cristian\nprogetto\ndesign\nserver\nsviluppo\ndocumento' \
		--trace /tmp/ascolto-test/call_trace.jsonl

probe: build
	./$(HARNESS) probe-macos
	./$(HARNESS) probe-engine

run: bundle
	open $(APP_BUNDLE)

clean:
	rm -rf $(BIN_DIR) $(OBJ_DIR)
