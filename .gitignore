# Build artifacts
build/
bin/
*.o
*.a
*.so
*.d

# Coverage and sanitizer outputs
*.gcda
*.gcno
*.gcov
asan.log*
ubsan.log*

# Model weights and large audio fixtures (unless explicitly tracked)
third_party/whistle/*.cact
*.wav.raw

# Runtime sockets, logs, and temporary files
*.sock
*.pid
/tmp/
.DS_Store

# macOS SDK artifacts, models, and generated verification output
models/
vendor/needle/needle
*.dylib
tests/fixtures/
tests/room-results/
tests/room-baseline/
tests/legacy-results/
tests/*.log
tests/*.sample.txt
tests/*-hang.txt
tests/audio-feedback.json
__pycache__/
*.py[cod]

# Local credentials and runtime databases
.env
.env.*
!.env.example
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Optional isolated Python environment for recap dependencies
.venv/
